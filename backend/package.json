{
  "name": "estateflow-backend",
  "version": "0.13.4",
  "private": true,
  "description": "EstateFlow: resource-aware resort booking and locally-trained enquiry assistant",
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "db:migrate": "ts-node --transpile-only scripts/migrate.ts",
    "db:seed": "ts-node --transpile-only scripts/seed.ts",
    "agent:train": "ts-node --transpile-only scripts/train-agent.ts",
    "agent:evaluate": "ts-node --transpile-only scripts/evaluate-agent.ts",
    "test:unit": "ts-node --transpile-only test/unit.ts",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "db:verify": "ts-node --transpile-only scripts/verify-invariants.ts",
    "agent:cv": "ts-node --transpile-only scripts/evaluate-agent-cv.ts",
    "test:agent": "ts-node --transpile-only test/agent-v3.unit.ts",
    "test:all": "npm run test:unit && npm run test:agent && npm run test:m4 && npm run agent:evaluate && npm run agent:cv && npm run test:m5 && npm run test:m6 && npm run test:m7 && npm run agent:holdout && npm run test:m8 && npm run test:m9 && npm run test:m10 && npm run test:m11 && npm run test:m12",
    "test:m4": "ts-node --transpile-only test/m4-contract.unit.ts",
    "test:m5": "ts-node --transpile-only test/m5-contract.unit.ts",
    "preflight": "node scripts/preflight.mjs",
    "test:m6": "ts-node --transpile-only test/m6-security.unit.ts",
    "agent:holdout": "ts-node --transpile-only scripts/evaluate-agent-holdout.ts",
    "test:m7": "ts-node --transpile-only test/m7-quality.unit.ts",
    "agent:import-reviewed": "ts-node --transpile-only scripts/import-reviewed.ts",
    "agent:final-check": "ts-node --transpile-only scripts/evaluate-agent-holdout.ts --final",
    "test:m8": "ts-node --transpile-only test/m8-frontend-client.unit.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "smoke:m8": "node scripts/smoke-m8.mjs",
    "contract:m9": "node scripts/generate-openapi-m9.mjs",
    "test:m9": "node scripts/verify-contract-m9.mjs",
    "smoke:m9": "node scripts/smoke-m9.mjs",
    "test:m10": "node test/m10-security.unit.mjs",
    "security:verify": "node scripts/verify-dependencies-m10.mjs",
    "security:config": "node scripts/verify-runtime-config-m10.mjs",
    "test:m11": "ts-node --transpile-only test/m11-cancellation.unit.ts",
    "audit:cancellations": "ts-node --transpile-only scripts/cancellation-audit.ts",
    "test:m12": "node test/m12-operations.unit.mjs",
    "reviewer:ready": "node scripts/reviewer-readiness-m12.mjs",
    "backup:demo": "node scripts/backup-demo-m12.mjs",
    "test:m13": "node test/m13-fullstack-contract.mjs",
    "demo:accounts": "ts-node --transpile-only scripts/demo-accounts-m14.ts",
    "test:design": "node test/lovable-preservation.mjs",
    "test:connection": "ts-node --transpile-only test/m14-local-connection.unit.ts",
    "test:m15": "ts-node --transpile-only test/m15-concierge-gm.unit.ts",
    "test:m16": "ts-node --transpile-only test/m16-ollama.unit.ts",
    "test:m17": "ts-node --transpile-only test/m17-venue-navigation.unit.ts",
    "test:m18": "node test/m18-workflow-contract.mjs",
    "smoke:ollama": "ts-node --transpile-only scripts/ollama-smoke.ts",
    "test:m19": "ts-node --transpile-only test/m19-concierge-performance.unit.ts",
    "test:m20": "node test/m20-promo-export-inbox.contract.mjs",
    "test:m22": "node test/m22-gm-venue-workflow.contract.mjs",
    "test:m23": "node test/m23-review-consistency.mjs",
    "test:m24": "node test/m24-gm-resolution-notification.contract.mjs",
    "test:m25": "node test/m25-client-alternatives-confirmed-export.contract.mjs",
    "test:m26": "node test/m26-master-detail-layout.contract.mjs",
    "test:m27": "node test/m27-phone-inbox-ai-branding.contract.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
